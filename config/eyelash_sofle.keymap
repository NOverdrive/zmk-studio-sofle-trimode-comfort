#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    behaviors {
        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <900>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <1>;      // 0
            time-to-max-speed-ms = <400>;      // 500
            delay-ms = <0>;                   //   10
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC                  &kp N1        &kp N2        &kp N3            &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8           &kp N9         &kp N0           &kp DELETE
&kp TAB                  &kp Q         &kp W         &kp E             &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I            &kp O          &kp P            &mt CAPSLOCK BACKSLASH
&kp BACKSPACE            &kp A         &kp S         &kp D             &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J      &kp K            &kp L          &kp SEMI         &kp APOS
&sk LSHFT                &kp Z         &kp X         &kp C             &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA        &kp DOT        &kp FSLH         &mt RIGHT_BRACKET LEFT_BRACKET
&mt C_MUTE C_PLAY_PAUSE  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_CONTROL  &mo 1   &kp SPACE    &mt END HOME     &kp SPACE  &kp ENTER  &sk RIGHT_SHIFT  &lt 2 PAGE_UP  &lt 3 PAGE_DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
            label = "Base";
        };

        Nav {
            bindings = <
&kp GRAVE   &kp F1         &kp F2     &kp F3           &kp F4            &kp F5               &mmv MOVE_UP     &kp F6     &kp F7    &kp F8    &kp F9     &kp F10    &kp F11
&kp TILDE   &trans         &mkp LCLK  &mkp MCLK        &mkp RCLK         &trans               &mmv MOVE_DOWN   &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp MINUS  &kp EQUAL
&trans      &trans         &trans     &trans           &trans            &trans               &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &trans
&trans      &trans         &trans     &trans           &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))    &mmv MOVE_RIGHT  &trans     &trans    &trans    &trans     &trans     &trans
&kp C_MUTE  &kp LG(LS(S))  &kp LG(D)  &kp LC(LA(ESC))  &trans            &tog 0               &mkp LCLK        &trans     &trans    &trans    &tog 2     &tog 4
            >;

            display-name = "layer1";
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREVIOUS>;
            label = "Nav";
        };

        Num {
            bindings = <
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(LS(Z))    &trans  &trans               &kp KP_NUMLOCK   &kp SLASH        &kp ASTERISK     &kp MINUS  &trans
&trans  &trans     &trans     &trans     &trans     &trans           &trans  &trans               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS   &trans
&trans  &trans     &trans     &trans     &trans     &trans           &trans  &trans               &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans     &trans
&trans  &trans     &trans     &trans     &trans     &trans           &trans  &trans               &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp RET    &trans
&trans  &trans     &trans     &trans     &mo 1      &trans           &trans  &kp C_AL_CALCULATOR  &trans           &kp KP_N0        &trans           &kp DOT
            >;

            label = "Num";
            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_DOWN C_AC_SCROLL_UP>;
        };

        Setup {
            bindings = <
&soft_off    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &rgb_ug RGB_BRI  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &trans  &trans  &trans  &soft_off
&trans       &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans               &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans  &trans  &trans  &trans
&trans       &out OUT_USB  &out OUT_BLE    &trans        &trans        &ext_power EP_ON     &rgb_ug RGB_SPD  &trans           &trans           &trans  &trans  &trans  &trans
&bootloader  &trans        &trans          &bootloader   &trans        &ext_power EP_OFF    &rgb_ug RGB_SPI  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans  &trans  &trans  &bootloader
&trans       &sys_reset    &trans          &trans        &mo 1         &trans               &rgb_ug RGB_TOG  &rgb_ug RGB_TOG  &trans           &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "Setup";
        };

        HD {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mo 1   &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "HD";
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
